# Development-only configuration. Copy this file to .env; never reuse these
# values outside of a local machine.
COMPOSE_PROJECT_NAME=import-erp-local
POSTGRES_HOST_PORT=5432

# Images are fixed to an explicit release. Replace a tag by its approved digest
# before a shared environment is created.
POSTGRES_IMAGE=postgres:18.6-bookworm
KEYCLOAK_IMAGE=quay.io/keycloak/keycloak:26.7.1
AZURITE_IMAGE=mcr.microsoft.com/azure-storage/azurite:3.37.0
OTELCOL_IMAGE=otel/opentelemetry-collector-contrib:0.161.0

POSTGRES_SUPERUSER=postgres
POSTGRES_SUPERUSER_PASSWORD=local-postgres-only
ERP_DB_USER=import_erp_app
ERP_DB_PASSWORD=local-import-erp-only
DW_DB_USER=import_dw_app
DW_DB_PASSWORD=local-import-dw-only
KEYCLOAK_DB_USER=keycloak_app
KEYCLOAK_DB_PASSWORD=local-keycloak-only
KEYCLOAK_ADMIN=local-admin
KEYCLOAK_ADMIN_PASSWORD=local-keycloak-admin-only
