{
  "realm": "import-erp",
  "displayName": "ERP Comex (local)",
  "enabled": true,
  "sslRequired": "none",
  "registrationAllowed": false,
  "resetPasswordAllowed": true,
  "roles": {
    "realm": [
      { "name": "ADMINISTRATOR", "description": "ERP local administrator" }
    ]
  },
  "users": [
    {
      "id": "11111111-1111-1111-1111-111111111111",
      "username": "local-admin",
      "enabled": true,
      "emailVerified": true,
      "firstName": "Administrador",
      "lastName": "Local",
      "realmRoles": ["ADMINISTRATOR"],
      "credentials": [
        { "type": "password", "value": "local-admin-change-me", "temporary": false }
      ]
    }
  ],
  "clients": [
    {
      "clientId": "import-erp-web",
      "name": "ERP Comex local web",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": true,
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": false,
      "redirectUris": ["http://localhost:3000/*"],
      "webOrigins": ["http://localhost:3000"],
      "attributes": {
        "pkce.code.challenge.method": "S256"
      }
    },
    {
      "clientId": "import-erp-api",
      "name": "ERP Comex local API session",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "clientAuthenticatorType": "client-secret",
      "secret": "local-development-only-change-me",
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": false,
      "redirectUris": ["http://localhost:5000/signin-oidc"],
      "webOrigins": ["http://localhost:3000"],
      "attributes": {
        "pkce.code.challenge.method": "S256"
      }
    }
  ]
}
