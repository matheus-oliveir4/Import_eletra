# Template for the VPS HTTPS virtual host. Install in the active server block
# after configuring a real hostname and certificate with the VPS operator.
server {
    listen 443 ssl http2;
    server_name api.example.com;

    # Configure ssl_certificate and ssl_certificate_key using the VPS TLS
    # provider. Never commit private keys or real certificate material.

    client_max_body_size 1m;

    location / {
        proxy_pass http://127.0.0.1:4000;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;
        proxy_read_timeout 30s;
        proxy_connect_timeout 5s;
        proxy_send_timeout 30s;
    }
}
