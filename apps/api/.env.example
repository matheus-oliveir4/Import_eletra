# Copy to .env for local development and use a disposable/test database only.
# Production values belong in /etc/import-erp/api.env on the VPS.
# Bind PostgreSQL to loopback and use a least-privilege application role.
DATABASE_URL=postgresql://import_erp_app:REPLACE_ME@127.0.0.1:5432/import_erp
DATABASE_POOL_MAX=5

# Must match VPS_API_TOKEN configured in the Vercel project.
GATEWAY_TOKEN=REPLACE_WITH_LONG_RANDOM_SECRET

# OIDC credentials stay on the API host. Register the Vercel app origin/callback.
OIDC_ISSUER=https://identity.example.com
OIDC_CLIENT_ID=REPLACE_ME
OIDC_CLIENT_SECRET=REPLACE_ME
AUTH_SESSION_SECRET=REPLACE_WITH_LONG_RANDOM_SECRET
APP_PUBLIC_ORIGIN=https://your-app.vercel.app

# Restrict listener to local reverse proxy or Cloudflare Tunnel.
HOST=127.0.0.1
PORT=4000
